<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Android 11+ 패키지 가시성: 티맵 / 카카오맵 -->
    <queries>
        <package android:name="com.skt.tmap.ku" />
        <package android:name="net.daum.android.map" />
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="tmap" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="kakaomap" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Addr2Map">

        <!--
          컴포넌트는 spec §10 순서대로 추가:
          - ProcessTextActivity        : 7단계
          - AddrAccessibilityService   : 8단계
          - MainActivity (LAUNCHER)    : 9단계 (집)
          - MapActionReceiver          : 6단계 (알림 폴백)
        -->

    </application>

</manifest>
